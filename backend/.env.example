PORT=3333
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=condo_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/condo_app
PGADMIN_DEFAULT_EMAIL=admin@condo.local
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050
# Em dev com Flutter web, deixe vazio ou use true para refletir a origem (cookies de refresh).
# Em producao, defina a URL exata do frontend (ex.: https://app.seudominio.com).
CORS_ORIGIN=

# Obrigatorio em producao
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=14
PRE_AUTH_TOKEN_TTL_MIN=10
INVITE_WEB_BASE_URL=https://seu-app.vercel.app
INVITE_TOKEN_TTL_DAYS=7
