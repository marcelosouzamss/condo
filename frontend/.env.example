# Página de login interna (padrão). Para outro site ou app, defina a URL completa.
# Também pode usar ?login=https://... na landing.
# VITE_LOGIN_URL=/login

# Base da API (opcional). Em `npm run dev`, se vazio, os pedidos a `/api` e `/uploads` usam o proxy
# abaixo (ou `http://127.0.0.1:3333` por defeito).
# VITE_API_BASE_URL=http://localhost:3333

# Alvo do proxy do Vite em desenvolvimento (só quando VITE_API_BASE_URL está vazio).
# Use se o backend não estiver na porta 3333 ou noutra máquina na rede local.
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:3333

# Condomínio para nome/logo na tela de login (GET /api/auth/login-appearance). Sobrescrito por ?condoId= na URL.
# VITE_LOGIN_CONDO_ID=1
